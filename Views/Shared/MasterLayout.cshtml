<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Practice Website</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="~/css/Style.css" /> *@
    <style>
            *{
                margin:0px;
            }

            @@media screen and (max-width:576px){

                header img{
                    max-height:60px;
                    height:auto;
                }
            }
            .nav-link{
                color:#FFFFFF;
                font-size:25px;
                font-weight:500;
                transition:color 0.3s ease;

            }
    </style>
</head>
<body>
    <header class="container-fluid bg-success">
        <div class="row">
            <div class="col-sm-4">
                <img src="~/img/1.webp" class="img-fluid" style="max-height:100px; width:auto;" />
            </div>
            <div class="col-sm-8">
                <nav class="navbar navbar-expand-sm bg-success navbar-dark">
                    <div class="container-fluid">

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="collapsibleNavbar">
                            <ul class="navbar-nav">
                                <li class="nav-item"> <a class="nav-link" href="/Guest/Home">Home</a> </li>
                                <li class="nav-item"> <a class="nav-link" href="/Guest/AboutUs">About us</a> </li>
                                <li class="nav-item"> <a class="nav-link" href="/Guest/Services">Services</a> </li>
                                <li class="nav-item"> <a class="nav-link" href="/Guest/ContactUs">Contact Us</a> </li>
                                <li class="nav-item"> <a class="nav-link" href="/Guest/Gallery">Gallery</a> </li>

                            </ul>
                        </div>
                    </div>
                </nav>

            </div>

        </div>


    </header>
    <div class="container-fluid  bg-info">
        @RenderBody()
    </div>
    <footer class="container-fluid bg-success mb-0">
        <div class="row">
            <div class="col-sm-4">
                <h3">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy </h3>
                    </div>

                    <div class="col-sm-4">
                    <ul>
                    <li> <a href="/Guest/Home">Home</a> </li>
                    <li> <a href="/Guest/AboutUs">About us</a> </li>
                    <li> <a href="/Guest/Services">Services</a> </li>
                    <li> <a href="/Guest/ContactUs">Contact Us</a> </li>
                    <li> <a href="/Guest/Gallery">Gallery</a> </li>
                </ul>
            </div>

            <div class="col-sm-4">
                <h3>Social Menu</h3>
            </div>




        </footer>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    </body>
</html>
